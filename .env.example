# Copy to .env.local. Values below are the local Supabase CLI defaults (`npx supabase start`);
# run `npx supabase status` to see yours. Never commit real values.

# Server only — pooler URL in hosted environments (port 6543), direct locally.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct (non-pooled) URL used by drizzle-kit for migrations.
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# a.k.a. anon key; safe in the browser only because every table has RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# a.k.a. service role key; server only, bypasses RLS.
SUPABASE_SECRET_KEY=

APP_URL=http://localhost:3000

SEED_TENANT_TIMEZONE=Australia/Sydney
SEED_TENANT_CURRENCY=AUD
SEED_TENANT_COUNTRY=AU

# --- Hiring ---------------------------------------------------------------------------------
# Encrypts tax file, bank and super numbers at rest. Generate with: openssl rand -base64 32
# Losing this key makes the stored numbers unreadable.
HR_ENCRYPTION_KEY=
# Only while rotating (ADR-040): the old key(s), comma-separated, so existing values stay
# readable until "Re-encrypt now" in /platform has moved them onto HR_ENCRYPTION_KEY.
HR_ENCRYPTION_KEYS_PREVIOUS=
# Transactional email (Resend). Without both, contract links are shown to the admin to copy.
RESEND_API_KEY=
EMAIL_FROM="Your Company <hiring@example.com>"
# Fair Work Commission Modern Awards Pay Database key (https://developer.fwc.gov.au).
# Without it, award names and minimum rates are typed in and marked as unverified.
FWC_API_KEY=

# --- Platform (ADR-029) ------------------------------------------------------------------------
# Comma-separated emails of the people who run Meroidea itself. They can open /platform to
# onboard businesses, switch features and enter any workspace for support. Keep this list short.
PLATFORM_ADMIN_EMAILS=

# --- Documents (ADR-030) -------------------------------------------------------------------------
# The document editing service (OnlyOffice Document Server); see docker-compose.onlyoffice.yml.
# Without the first two, documents can be stored and downloaded but not edited in the browser.
ONLYOFFICE_URL=
# Shared secret, the same value the editing service is started with. openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=
# How the editing service reaches this app, when that is not APP_URL (it runs in Docker locally).
APP_INTERNAL_URL=
# How this app reaches the editing service, when that is not ONLYOFFICE_URL.
ONLYOFFICE_INTERNAL_URL=

# Public sign-up is off: businesses are created from the platform console. Set this to true
# only to create the very first account (your own), then remove it again.
# ALLOW_PUBLIC_SIGNUP=true
